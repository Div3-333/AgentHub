{
  "name": "gemini",
  "display_name": "Gemini CLI",
  "executable": "gemini",
  "args": ["--skip-trust"],
  "env": {
    "NO_COLOR": "1",
    "TERM": "dumb",
    "GEMINI_CLI_TRUST_WORKSPACE": "true"
  },
  "prompt_regex": "^>\\s*$",
  "silence_timeout_ms": 5000,
  "init_sequence": [],
  "rate_limit_patterns": ["rate limit", "quota exceeded", "429"],
  "auto_reply_patterns": {},
  "supports_multi_instance": true,
  "max_instances": 0
}
